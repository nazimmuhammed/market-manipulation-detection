TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
GMAIL_USER=your_gmail_address_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here
# Autonomous alert email — sent automatically (no button click) whenever an
# alert reaches ALERT_EMAIL_MIN_RISK (HIGH or CRITICAL). Same Gmail app password above.
AUTHORIZED_EMAIL=compliance_officer_email_here
ALERT_EMAIL_MIN_RISK=HIGH